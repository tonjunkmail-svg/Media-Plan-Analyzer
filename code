  </div>

  <div class="card">
    <div class="card-title">📊 KPI Targets</div>
    <table class="kpi-edit-table">
      <thead><tr><th>Channel</th><th>KPI</th><th>Target</th><th>Unit</th></tr></thead>
      <tbody>
        ${state.channels.map(ch => {
