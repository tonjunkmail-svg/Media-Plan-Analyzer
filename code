}

// ===================== REACH SATURATION CURVE CHART =====================
function renderReachCurve() {
  const ctx = document.getElementById('reach-curve-chart');
  if (!ctx) return;

  // Pick the primary paid channel with the largest budget
  const primaryCh = state.channels
    .filter(ch => ['digital','tv','ooh','influencer'].includes(ch))
    .sort((a,b) => (state.budgets[b] || 0) - (state.budgets[a] || 0))[0];
  if (!primaryCh) return;

  const budget = state.budgets[primaryCh] || 0;
  const bench = getBench(primaryCh);
  const cpmMult = getSeasonalCPMMultiplier(primaryCh);
  const halfSat = saturationParams[primaryCh]?.halfSat || 500000;

  // Build saturation curve: 0 → 2× current budget (min 2Cr for context)
  const maxBudget = Math.max(budget * 2.5, 2000000, halfSat * 4);
  const steps = 24;
  const labels = [], reachData = [], marginalData = [];

  for (let i = 1; i <= steps; i++) {
    const b = (maxBudget / steps) * i;
    labels.push(fmtINR(b));
    let reach = 0;
    if (primaryCh === 'digital') {
      const effectiveCPM = (bench.cpm || 100) * cpmMult;
      const impressions = (b / effectiveCPM) * 1000;
      reach = (impressions * 0.72 * b / (b + halfSat)) / 100000; // in Lakhs
    } else if (primaryCh === 'tv') {
      reach = 75 * b / (b + halfSat); // percentage
    } else if (primaryCh === 'ooh') {
      const effectiveCPM = (bench.cpm || 60) * cpmMult;
      const impressions = (b / effectiveCPM) * 1000;
      reach = (impressions * 0.6 * b / (b + halfSat)) / 100000;
    } else if (primaryCh === 'influencer') {
      const maxCreators = b / (bench.avg_followers * 0.1);
      const creators = maxCreators * b / (b + halfSat);
      reach = (creators * (bench.avg_followers || 50000)) / 100000;
    }
    reachData.push(Math.max(0, parseFloat(reach.toFixed(2))));
  }

  // Mark current spend point
  const currentStepF = (budget / maxBudget) * steps;
  const pointRadii = reachData.map((_, i) => {
    return Math.abs(i - (currentStepF - 1)) < 1 ? 7 : 2;
  });
  const pointColors = reachData.map((_, i) =>
    Math.abs(i - (currentStepF - 1)) < 1 ? '#e94560' : channelConfig[primaryCh].color
  );

  if (reachCurveChart) reachCurveChart.destroy();
  const yLabel = primaryCh === 'tv' ? 'Est. Reach (%)' : 'Est. Reach (Lakhs)';
  reachCurveChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: `${channelConfig[primaryCh].name} Reach`,
        data: reachData,
        borderColor: channelConfig[primaryCh].color,
        backgroundColor: channelConfig[primaryCh].color + '1a',
        tension: 0.45,
        fill: true,
        pointRadius: pointRadii,
        pointBackgroundColor: pointColors,
        pointBorderColor: pointColors,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: {
          label: c => ` ${yLabel}: ${c.raw}`,
          title: t => `Budget: ${t[0].label}`
        }}
      },
      scales: {
        x: { ticks: { maxRotation: 50, font: { size: 8 }, maxTicksLimit: 10 }, grid: { display: false } },
        y: { title: { display: true, text: yLabel, font: { size: 9 } }, ticks: { font: { size: 9 } } }
      }
    }
  });

  const optSpendEl = document.getElementById('opt-spend-info');
  if (optSpendEl) {
    const budgetVsOpt = budget < halfSat ? '⬇️ below' : budget < halfSat * 2 ? '✅ near' : '⬆️ above';
    optSpendEl.innerHTML = `<span class="opt-spend-badge">💡 Inflection point for ${channelConfig[primaryCh].name}: ${fmtINR(halfSat)} — your current spend (${fmtINR(budget)}) is ${budgetVsOpt} optimal</span>`;
  }
}

// ===================== CAMPAIGN MEMORY =====================
function saveCampaign() {
  const name = document.getElementById('f_name')?.value?.trim();
  if (!name) { alert('Please enter a Campaign Name (Step 1) before saving.'); return; }
  recalcProjections();
  const plan = {
    id: Date.now(),
    name,
    brand: document.getElementById('f_brand')?.value || '',
    savedAt: new Date().toLocaleDateString('en-IN'),
    totalBudget: getTotalBudget(),
    industry: getIndustry(),
    objective: document.getElementById('f_objective')?.value || '',
    weeks: getWeeks(),
    channels: [...state.channels],
    budgets: { ...state.budgets },
    kpis: { ...state.kpis },
    audience: document.getElementById('f_audience')?.value || '',
    geo: document.getElementById('f_geo')?.value || '',
    start: document.getElementById('f_start')?.value || '',
    end: document.getElementById('f_end')?.value || '',
  };
  // Replace if same name exists, else prepend
  const existingIdx = campaignMemory.findIndex(p => p.name === name);
  if (existingIdx >= 0) campaignMemory[existingIdx] = plan;
  else campaignMemory.unshift(plan);
  campaignMemory = campaignMemory.slice(0, 5); // keep last 5 plans
  try { localStorage.setItem(MEMORY_KEY, JSON.stringify(campaignMemory)); } catch(e) {}
  renderMemoryPanel();
  alert(`✅ Plan "${name}" saved to Brand Memory.`);
}

function loadCampaign(id) {
  const plan = campaignMemory.find(p => p.id === id);
  if (!plan) return;
  if (!confirm(`Load "${plan.name}"?\n\nThis will replace your current plan.`)) return;

  document.getElementById('f_name').value = plan.name || '';
  document.getElementById('f_brand').value = plan.brand || '';
  document.getElementById('f_budget').value = plan.totalBudget || '';
  document.getElementById('f_industry').value = plan.industry || 'fmcg';
  document.getElementById('f_objective').value = plan.objective || '';
  document.getElementById('f_weeks').value = plan.weeks || 8;
  document.getElementById('f_audience').value = plan.audience || '';
  document.getElementById('f_geo').value = plan.geo || '';
  if (plan.start) document.getElementById('f_start').value = plan.start;
  if (plan.end) document.getElementById('f_end').value = plan.end;

  state.channels = plan.channels?.length ? [...plan.channels] : ['digital'];
  state.budgets = { ...plan.budgets } || {};
  state.kpis = { ...plan.kpis } || {};
  state.flighting = {};

  // Sync channel card UI
  document.querySelectorAll('.ch-card').forEach(c => c.classList.remove('selected'));
  state.channels.forEach(ch => document.getElementById(`ch-card-${ch}`)?.classList.add('selected'));

  renderSliders();
  renderFlighting();
  updateSidebar();
  recalcAll();
  goStep(1);
}

