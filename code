  retail:  { digital: { cpm:85, ctr:1.5, roas:5.0, cpl:90, cpc:10, conv_rate:2.5, vtr:48 }, email: { open:25, ctr:4.2, conv:2.2, unsub:0.3 }, tv: { cpp:18000, freq:3.5, recall:6 }, ooh: { cpm:55, freq:6 }, print: { cpm:160, readership:2.5 }, influencer: { cpe:7, er:3.5, avg_followers:40000 } },
