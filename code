        <tbody>
          ${state.channels.map((ch,ci) => {
            const cfg = channelConfig[ch];
            const budget = state.budgets[ch] || 0;
            const activeCount = countActiveWeeks(ch) || 1;
            return `<tr><td class="ch-label">${cfg.icon} ${cfg.name}</td>${
              Array.from({length:weeks},(_,w) => {
                const active = (state.flighting[ch] || [])[w];
