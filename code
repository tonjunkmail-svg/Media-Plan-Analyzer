function exportExcel() {
  const name = document.getElementById('f_name')?.value || 'Campaign';
  const brand = document.getElementById('f_brand')?.value || '';
  const totalBudget = getTotalBudget();
  const weeks = getWeeks();
  const obj = document.getElementById('f_objective');
  const objText = obj?.options[obj.selectedIndex]?.text || '';
  const industry = getIndustry();
  const today = new Date().toLocaleDateString('en-IN');

  recalcProjections();
  const wb = XLSX.utils.book_new();

  // ---- Sheet 1: Summary ----
  const s1 = [
    ['CAMPAIGN MEDIA PLAN', '', '', ''],
    ['', '', '', ''],
    ['Campaign Name', name, 'Brand', brand],
    ['Objective', objText, 'Industry', industry.toUpperCase()],
    ['Total Budget', totalBudget, 'Duration', `${weeks} weeks`],
    ['Audience', document.getElementById('f_audience')?.value || '', 'Geography', document.getElementById('f_geo')?.value || ''],
    ['Prepared', today, '', ''],
    ['', '', '', ''],
    ['CHANNEL SUMMARY', '', '', ''],
    ['Channel', 'Budget (₹)', 'Budget %', 'Active Weeks'],
    ...state.channels.map(ch => {
      const pct = totalBudget > 0 ? Math.round((state.budgets[ch] || 0) / totalBudget * 100) : 0;
      return [channelConfig[ch].name, state.budgets[ch] || 0, `${pct}%`, countActiveWeeks(ch)];
    }),
    ['TOTAL', totalBudget, '100%', ''],
  ];
  const ws1 = XLSX.utils.aoa_to_sheet(s1);
  ws1['!cols'] = [{ wch: 22 }, { wch: 18 }, { wch: 22 }, { wch: 20 }];
  XLSX.utils.book_append_sheet(wb, ws1, 'Summary');

  // ---- Sheet 2: Budget Allocation ----
  const s2 = [
    ['Channel', 'Budget (₹)', 'Budget %', 'Objective Rationale'],
    ...state.channels.map(ch => {
      const pct = totalBudget > 0 ? Math.round((state.budgets[ch] || 0) / totalBudget * 100) : 0;
      const rationale = { digital:'Primary performance & reach channel', email:'High-ROI owned channel for CRM', tv:'Mass-reach brand awareness', ooh:'Non-skippable high-visibility', print:'Credibility & long-form messaging', influencer:'Authentic social proof & engagement' }[ch] || '';
      return [channelConfig[ch].name, state.budgets[ch] || 0, `${pct}%`, rationale];
    }),
  ];
  const ws2 = XLSX.utils.aoa_to_sheet(s2);
  ws2['!cols'] = [{ wch: 16 }, { wch: 16 }, { wch: 12 }, { wch: 40 }];
  XLSX.utils.book_append_sheet(wb, ws2, 'Budget Allocation');

  // ---- Sheet 3: Flighting Calendar ----
  const wkHeaders = Array.from({ length: weeks }, (_, i) => `Week ${i + 1}`);
  const s3 = [
    ['FLIGHTING CALENDAR'],
    ['Channel', ...wkHeaders, 'Total Budget', 'Active Weeks'],
    ...state.channels.map(ch => {
      const budget = state.budgets[ch] || 0;
      const activeCount = countActiveWeeks(ch) || 1;
      const weeklyBudget = Math.round(budget / activeCount);
      const cells = Array.from({ length: weeks }, (_, w) => {
        const active = (state.flighting[ch] || [])[w];
        return active ? weeklyBudget : 0;
      });
      return [channelConfig[ch].name, ...cells, budget, activeCount];
    }),
    ['TOTAL', ...Array.from({ length: weeks }, (_, w) =>
      state.channels.reduce((s, ch) => {
        const active = (state.flighting[ch] || [])[w];
        const activeCount = countActiveWeeks(ch) || 1;
        return s + (active ? Math.round((state.budgets[ch] || 0) / activeCount) : 0);
      }, 0)
    ), totalBudget, ''],
  ];
  const ws3 = XLSX.utils.aoa_to_sheet(s3);
  ws3['!cols'] = [{ wch: 14 }, ...Array(weeks).fill({ wch: 11 }), { wch: 14 }, { wch: 12 }];
  XLSX.utils.book_append_sheet(wb, ws3, 'Flighting Calendar');

  // ---- Sheet 4: KPI Targets ----
  const s4 = [['Channel', 'KPI', 'Your Target', 'Unit', 'Industry Benchmark']];
  state.channels.forEach(ch => {
    const defs = kpiDefs[ch] || [];
    const bench = getBench(ch);
    defs.forEach(k => {
      s4.push([channelConfig[ch].name, k.label, state.kpis[`${ch}_${k.id}`] ?? bench[k.bench_key] ?? '', k.unit, bench[k.bench_key] ?? '']);
    });
  });
  const ws4 = XLSX.utils.aoa_to_sheet(s4);
  ws4['!cols'] = [{ wch: 16 }, { wch: 22 }, { wch: 16 }, { wch: 10 }, { wch: 20 }];
  XLSX.utils.book_append_sheet(wb, ws4, 'KPI Targets');

  // ---- Sheet 5: Projections ----
  const s5 = [['REACH & FREQUENCY PROJECTIONS'], ['Channel', 'Budget', 'Est. Impressions', 'Est. Reach', 'Key Projection', 'Value']];
  state.channels.forEach(ch => {
    const p = projCache[ch];
    if (!p) return;
    p.metrics.forEach((m, i) => {
      s5.push([i === 0 ? channelConfig[ch].name : '', i === 0 ? (state.budgets[ch] || 0) : '', i === 0 ? p.impressions : '', i === 0 ? p.reach : '', m.label, m.value]);
    });
  });
  const ws5 = XLSX.utils.aoa_to_sheet(s5);
  ws5['!cols'] = [{ wch: 16 }, { wch: 14 }, { wch: 18 }, { wch: 16 }, { wch: 22 }, { wch: 14 }];
  XLSX.utils.book_append_sheet(wb, ws5, 'Projections');

  XLSX.writeFile(wb, `${name.replace(/\s+/g,'_')}_Media_Plan.xlsx`);
}

