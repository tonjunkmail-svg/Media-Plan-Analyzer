    [{ text: 'Role', options: { bold: true, color: WHITE, fill: BG_MED } }, { text: 'Name', options: { bold: true, color: WHITE, fill: BG_MED } }, { text: 'Decision', options: { bold: true, color: WHITE, fill: BG_MED } }, { text: 'Date', options: { bold: true, color: WHITE, fill: BG_MED } }],
    [{ text: 'Brand Manager', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }],
    [{ text: 'Marketing Head', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }],
    [{ text: 'Media Agency Lead', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }],
    [{ text: 'Finance / Procurement', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }, { text: '', options: { color: WHITE } }],
  ];
  s8.addTable(signoffRows, { x: 0.5, y: 1.4, w: 12.3, colW: [3.5, 3.5, 2.8, 2.5], rowH: 0.6, fontFace: 'Segoe UI', fontSize: 12, border: { type: 'solid', color: '444466', pt: 0.5 } });
  s8.addText([{ text: `${name} Media Plan  `, options: { bold: true, color: WHITE } }, { text: '·  ' + today, options: { color: 'aaaaaa' } }], { x: 0.5, y: 6.9, w: 12, h: 0.4, fontSize: 11, fontFace: 'Segoe UI' });

  await pptx.writeFile({ fileName: `${name.replace(/\s+/g,'_')}_Media_Plan.pptx` });
}

// ===================== RESET =====================
function resetAll() {
  if (!confirm('Reset all plan data?')) return;
  state.channels = ['digital'];
  state.budgets = {};
  state.flighting = {};
  state.kpis = {};
  document.querySelectorAll('input, select').forEach(el => { if (el.type !== 'range') el.value = ''; });
  document.getElementById('f_weeks').value = 8;
  document.querySelectorAll('.ch-card').forEach(c => c.classList.remove('selected'));
  document.getElementById('ch-card-digital').classList.add('selected');
  renderSliders();
  renderFlighting();
  updateSidebar();
  if (donutChart) { donutChart.destroy(); donutChart = null; }
  goStep(1);
}

// ===================== INIT =====================
function init() {
  renderSliders();
  renderFlighting();
  updateSidebar();
  renderMemoryPanel();
  // Set today's date defaults
  const today = new Date();
  const nextMonth = new Date(today); nextMonth.setMonth(nextMonth.getMonth() + 2);
  document.getElementById('f_start').value = today.toISOString().split('T')[0];
  document.getElementById('f_end').value = nextMonth.toISOString().split('T')[0];
  calcWeeks();
}
init();
</script>
