<script>
// ===================== STATE =====================
const state = {
  channels: ['digital'],
  budgets: {},
  flighting: {},  // ch -> array of bool per week
  kpis: {},
};

let donutChart = null;
let reachCurveChart = null;
const MEMORY_KEY = 'mpb_campaigns_v1';
let campaignMemory = [];
try { campaignMemory = JSON.parse(localStorage.getItem(MEMORY_KEY) || '[]'); } catch(e) { campaignMemory = []; }

// ===================== CHANNEL CONFIG =====================
const channelConfig = {
