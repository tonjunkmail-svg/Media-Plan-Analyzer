// ===================== RISK DETECTOR =====================
function detectRisks() {
  const risks = [];
  const totalBudget = getTotalBudget();
  const objective = document.getElementById('f_objective')?.value || '';
  const weeks = getWeeks();
  if (!totalBudget || !state.channels.length) return risks;

  // Risk 1: Single channel dominance > 65%
  state.channels.forEach(ch => {
    const pct = (state.budgets[ch] || 0) / totalBudget * 100;
    if (pct > 65) {
      risks.push({ level:'high', icon:'⚠️', title:`${channelConfig[ch].name} over-concentration (${Math.round(pct)}%)`,
        desc:`More than 65% of budget on a single channel risks reach ceiling and frequency fatigue. Consider shifting 10–15% to complementary channels.` });
    }
  });

  // Risk 2: Awareness objective with no high-reach channel at meaningful spend
  if (objective === 'awareness') {
    const hasHighReach = state.channels.some(ch =>
      ['tv','ooh'].includes(ch) && (state.budgets[ch] || 0) / totalBudget > 0.10
    ) || ((state.budgets['digital'] || 0) / totalBudget > 0.25);
    if (!hasHighReach) {
      risks.push({ level:'high', icon:'📡', title:'Awareness plan lacks high-reach channel',
        desc:'Brand awareness campaigns need TV/OOH (>10% each) or substantial Digital (>25%). Current allocation may not achieve population-level reach.' });
    }
  }

  // Risk 3: Performance objective with high TV allocation
  if (objective === 'performance') {
    const tvPct = (state.budgets['tv'] || 0) / totalBudget * 100;
    if (tvPct > 25) {
      risks.push({ level:'medium', icon:'🎯', title:`TV at ${Math.round(tvPct)}% — high for performance objective`,
        desc:'TV drives awareness and recall but is hard to attribute to conversions. For performance campaigns, reallocate TV budget toward Digital or Email for better trackability.' });
    }
  }

  // Risk 4: Retention objective missing Email channel
  if (objective === 'retention') {
    const emailBudget = state.budgets['email'] || 0;
    if (!state.channels.includes('email') || emailBudget === 0) {
      risks.push({ level:'medium', icon:'📧', title:'Retention campaign missing Email/CRM',
        desc:'Email is the highest-ROI retention channel (typical ROAS 30–40x). Without it, you are using paid media to retain users you already own.' });
    }
  }

  // Risk 5: Burst pattern over-concentrated in ≤2 weeks on a long campaign
  state.channels.forEach(ch => {
    const flight = state.flighting[ch] || [];
    const totalActive = flight.filter(Boolean).length;
    if (weeks >= 6 && totalActive > 0 && totalActive <= 2) {
      risks.push({ level:'medium', icon:'💥', title:`${channelConfig[ch].name}: burst in ${totalActive}/${weeks} weeks only`,
        desc:`Concentrating all ${channelConfig[ch].name} spend in ${totalActive} of ${weeks} weeks is a very short burst. Audiences may not build sufficient frequency, and there is no sustained presence.` });
    }
  });

  // Risk 6: Seasonal CPM spike — budget may underdeliver
  const startDate = document.getElementById('f_start')?.value;
  if (startDate) {
    const month = new Date(startDate).getMonth();
    const highSeasonEvents = indiaMediaCalendar.filter(ev => ev.months.includes(month) && ev.cpmMultiplier >= 1.3);
    highSeasonEvents.forEach(ev => {
      risks.push({ level:'medium', icon:'📅', title:`${ev.emoji} ${ev.name} season — CPMs elevated ×${ev.cpmMultiplier}`,
        desc:`Your campaign starts during ${ev.name}. Industry CPMs are typically ${Math.round((ev.cpmMultiplier-1)*100)}% higher. Your actual reach may be lower than baseline projections — consider adjusting budget upward or shifting start date.` });
    });
  }

  // Risk 7: No risks — plan looks healthy
  if (risks.length === 0) {
    risks.push({ level:'ok', icon:'✅', title:'No major strategic risks detected',
      desc:'Your plan structure looks sound. Double-check KPI targets against benchmarks and confirm flighting matches your campaign momentum needs.' });
  }

  return risks;
}

function renderRiskPanel() {
  const panel = document.getElementById('risk-panel');
  if (!panel) return;
  const risks = detectRisks();
  panel.innerHTML = `
    <div class="card">
      <div class="card-title">🔍 Automated Plan Risk Check</div>
      <div class="card-sub">Strategic review against media planning best practices and your campaign parameters.</div>
      ${risks.map(r => `
        <div class="risk-card risk-${r.level}">
          <div class="risk-icon">${r.icon}</div>
          <div class="risk-text"><strong>${r.title}</strong>${r.desc}</div>
