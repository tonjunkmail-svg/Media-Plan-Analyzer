  telecom: { digital: { cpm:95, ctr:0.8, roas:4.0, cpl:180, cpc:15, conv_rate:1.8, vtr:42 }, email: { open:20, ctr:3.0, conv:1.2, unsub:0.5 }, tv: { cpp:22000, freq:5, recall:9 }, ooh: { cpm:65, freq:8 }, print: { cpm:170, readership:2.8 }, influencer: { cpe:10, er:3, avg_followers:60000 } },
  auto:    { digital: { cpm:120, ctr:0.7, roas:3.8, cpl:400, cpc:25, conv_rate:1.2, vtr:55 }, email: { open:23, ctr:4.0, conv:1.4, unsub:0.35 }, tv: { cpp:28000, freq:4.5, recall:12 }, ooh: { cpm:75, freq:7 }, print: { cpm:220, readership:3 }, influencer: { cpe:15, er:3.5, avg_followers:70000 } },
};

// Recommended budget splits by objective
const recommendedSplits = {
  awareness:    { digital:45, tv:30, ooh:15, email:0,  print:5,  influencer:5  },
  consideration:{ digital:50, tv:20, ooh:10, email:5,  print:5,  influencer:10 },
  performance:  { digital:65, tv:0,  ooh:5,  email:15, print:0,  influencer:15 },
  launch:       { digital:40, tv:30, ooh:15, email:5,  print:5,  influencer:5  },
  retention:    { digital:30, tv:0,  ooh:0,  email:50, print:0,  influencer:20 },
  seasonal:     { digital:50, tv:25, ooh:15, email:5,  print:0,  influencer:5  },
};

// ===================== INDIA MEDIA CALENDAR =====================
// months are 0-indexed (Jan=0, Dec=11)
const indiaMediaCalendar = [
  { name:'Republic Day', months:[0], cpmMultiplier:1.1, badge:'season-republic', emoji:'🇮🇳', shortName:'R-Day' },
  { name:'Budget Day', months:[1], cpmMultiplier:1.15, badge:'season-budget', emoji:'📜', shortName:'Budget' },
  { name:'Board Exams', months:[2], cpmMultiplier:0.85, badge:'season-exam', emoji:'📚', shortName:'Exams↓' },
  { name:'IPL Season', months:[3,4], cpmMultiplier:1.40, badge:'season-ipl', emoji:'🏏', shortName:'IPL+40%' },
  { name:'Eid', months:[3,4], cpmMultiplier:1.20, badge:'season-eid', emoji:'🌙', shortName:'Eid' },
  { name:'Independence Day', months:[7], cpmMultiplier:1.10, badge:'season-independence', emoji:'🇮🇳', shortName:'I-Day' },
  { name:'Navratri', months:[9], cpmMultiplier:1.25, badge:'season-navratri', emoji:'💃', shortName:'Navratri' },
  { name:'Diwali', months:[10], cpmMultiplier:1.50, badge:'season-diwali', emoji:'🪔', shortName:'Diwali+50%' },
  { name:'Christmas & New Year', months:[11], cpmMultiplier:1.20, badge:'season-christmas', emoji:'🎄', shortName:'Xmas/NY' },
];

// ===================== SATURATION CURVE PARAMS =====================
// halfSat = budget level at which you achieve 50% of theoretical maximum reach
const saturationParams = {
  digital:    { halfSat: 500000 },    // inflection at ₹5L
  tv:         { halfSat: 3000000 },   // inflection at ₹30L
  ooh:        { halfSat: 800000 },    // inflection at ₹8L
  influencer: { halfSat: 600000 },    // inflection at ₹6L
  email:      { halfSat: 0 },         // linear
  print:      { halfSat: 0 },         // linear
};

// KPI definitions per channel
const kpiDefs = {
  digital:    [ { id:'ctr',       label:'CTR',            unit:'%',  bench_key:'ctr'       },
                { id:'roas',      label:'ROAS',           unit:'x',  bench_key:'roas'      },
                { id:'cpl',       label:'CPL',            unit:'₹',  bench_key:'cpl'       },
                { id:'cpc',       label:'CPC',            unit:'₹',  bench_key:'cpc'       },
                { id:'vtr',       label:'Video VTR',      unit:'%',  bench_key:'vtr'       } ],
  email:      [ { id:'open',      label:'Open Rate',      unit:'%',  bench_key:'open'      },
                { id:'ctr',       label:'CTR',            unit:'%',  bench_key:'ctr'       },
                { id:'conv',      label:'Conv. Rate',     unit:'%',  bench_key:'conv'      } ],
  tv:         [ { id:'recall',    label:'Brand Recall Lift', unit:'pts', bench_key:'recall' },
                { id:'freq',      label:'Target Frequency','unit':'x', bench_key:'freq'    } ],
  ooh:        [ { id:'freq',      label:'Target Frequency','unit':'x', bench_key:'freq'    } ],
  print:      [ { id:'readership','label':'Readership Mult.','unit':'x','bench_key':'readership' } ],
  influencer: [ { id:'er',        label:'Engagement Rate','unit':'%',  bench_key:'er'      },
                { id:'cpe',       label:'Cost Per Engagement','unit':'₹','bench_key':'cpe' } ],
};

// ===================== HELPERS =====================
const fmtINR = v => {
  if (!v) return '₹0';
  if (v >= 10000000) return `₹${(v/10000000).toFixed(1)}Cr`;
  if (v >= 100000)   return `₹${(v/100000).toFixed(1)}L`;
  if (v >= 1000)     return `₹${(v/1000).toFixed(0)}K`;
  return `₹${v.toFixed(0)}`;
};
const fmtNum = v => {
  if (!v) return '0';
  if (v >= 10000000) return `${(v/10000000).toFixed(1)}Cr`;
  if (v >= 100000)   return `${(v/100000).toFixed(1)}L`;
  if (v >= 1000)     return `${(v/1000).toFixed(0)}K`;
  return `${Math.round(v)}`;
};
const getTotalBudget = () => parseFloat(document.getElementById('f_budget')?.value) || 0;
const getWeeks = () => parseInt(document.getElementById('f_weeks')?.value) || 8;
const getIndustry = () => document.getElementById('f_industry')?.value || 'fmcg';
const getBench = ch => benchmarks[getIndustry()]?.[ch] || {};
const getChannelBudget = ch => state.budgets[ch] || 0;

// Active weeks for a channel
const getActiveWeeks = ch => {
  const w = getWeeks();
  if (!state.flighting[ch]) return Array(w).fill(true);
  return state.flighting[ch].slice(0, w);
};
const countActiveWeeks = ch => getActiveWeeks(ch).filter(Boolean).length;

// ===================== STEP NAVIGATION =====================
function goStep(n) {
  document.querySelectorAll('.section-step').forEach((s,i) => s.classList.toggle('active', i === n-1));
  document.querySelectorAll('.step-btn').forEach((b,i) => {
    b.classList.toggle('active', i === n-1);
    if (i < n-1) b.classList.add('done'); else b.classList.remove('done');
  });
  if (n === 3) renderFlighting();
  if (n === 4) { renderProjections(); renderKPITable(); }
  if (n === 5) renderSummary();
  updateSidebar();
}

// ===================== CALC WEEKS =====================
function calcWeeks() {
  const s = document.getElementById('f_start')?.value;
  const e = document.getElementById('f_end')?.value;
  if (s && e) {
    const diff = Math.ceil((new Date(e) - new Date(s)) / (1000*60*60*24*7));
    if (diff > 0 && diff <= 52) document.getElementById('f_weeks').value = diff;
  }
  renderFlighting();
  updateSidebar();
}

// ===================== CHANNEL TOGGLE =====================
function toggleChannel(ch) {
  const card = document.getElementById(`ch-card-${ch}`);
  if (state.channels.includes(ch)) {
    if (state.channels.length <= 1) return; // keep at least one
    state.channels = state.channels.filter(c => c !== ch);
    card.classList.remove('selected');
  } else {
    state.channels.push(ch);
    card.classList.add('selected');
  }
  renderSliders();
  renderFlighting();
  updateDonut();
  updateSidebar();
}

// ===================== SLIDERS =====================
function renderSliders() {
  const total = getTotalBudget();
  document.getElementById('total-budget-display').textContent = fmtINR(total);
  const container = document.getElementById('slider-container');
  container.innerHTML = state.channels.map(ch => {
    const cfg = channelConfig[ch];
    const pct = Math.round(((state.budgets[ch] || 0) / (total || 1)) * 100);
    return `
      <div class="slider-row">
        <div class="slider-ch-name"><span>${cfg.icon}</span>${cfg.name}</div>
        <div class="slider-wrap">
          <input type="range" min="0" max="100" value="${pct}" id="slider-${ch}"
            style="--val:${pct}%"
            oninput="onSliderMove('${ch}', this.value)" />
        </div>
        <div class="slider-pct" id="pct-${ch}">${pct}%</div>
        <div class="slider-amt" id="amt-${ch}">${fmtINR((pct/100)*total)}</div>
      </div>`;
  }).join('');
  updateBudgetWarning();
  updateDonut();
  updateSidebar();
}

function onSliderMove(ch, val) {
  val = parseInt(val);
  const total = getTotalBudget();
  state.budgets[ch] = Math.round((val / 100) * total);
  const el = document.getElementById(`slider-${ch}`);
  if (el) el.style.setProperty('--val', val + '%');
  document.getElementById(`pct-${ch}`).textContent = `${val}%`;
  document.getElementById(`amt-${ch}`).textContent = fmtINR(state.budgets[ch]);
  updateBudgetWarning();
  updateDonut();
  updateSidebar();
  recalcProjections();
}

function updateBudgetWarning() {
  const total = getTotalBudget();
  const allocated = state.channels.reduce((s, ch) => s + (state.budgets[ch] || 0), 0);
  const remaining = total - allocated;
  document.getElementById('remaining-budget').textContent = fmtINR(remaining);
  document.getElementById('remaining-budget').style.color = remaining < 0 ? 'var(--highlight)' : 'var(--green)';
  document.getElementById('budget-warn').style.display = remaining < -100 ? 'flex' : 'none';
}

function autoRecommend() {
  const obj = document.getElementById('f_objective')?.value || 'awareness';
  const splits = recommendedSplits[obj] || recommendedSplits.awareness;
  const total = getTotalBudget();
  const activeChannels = state.channels;

  // Redistribute splits across only active channels, normalise to 100
  let totalPct = activeChannels.reduce((s, ch) => s + (splits[ch] || 0), 0);
  if (totalPct === 0) totalPct = 100;
  activeChannels.forEach(ch => {
    const pct = ((splits[ch] || 0) / totalPct) * 100;
    state.budgets[ch] = Math.round((pct / 100) * total);
    const el = document.getElementById(`slider-${ch}`);
    if (el) { el.value = Math.round(pct); el.style.setProperty('--val', Math.round(pct) + '%'); }
    const pctEl = document.getElementById(`pct-${ch}`);
    const amtEl = document.getElementById(`amt-${ch}`);
    if (pctEl) pctEl.textContent = `${Math.round(pct)}%`;
    if (amtEl) amtEl.textContent = fmtINR(state.budgets[ch]);
  });
  updateBudgetWarning();
  updateDonut();
  updateSidebar();
}

// ===================== DONUT CHART =====================
function updateDonut() {
  const labels = state.channels.map(ch => channelConfig[ch].name);
  const data = state.channels.map(ch => state.budgets[ch] || 0);
  const colors = state.channels.map(ch => channelConfig[ch].color);
  const ctx = document.getElementById('donut-chart');
  if (!ctx) return;
  if (donutChart) donutChart.destroy();
  donutChart = new Chart(ctx, {
    type: 'doughnut',
    data: { labels, datasets: [{ data, backgroundColor: colors, borderWidth: 2, borderColor: 'white' }] },
    options: {
      responsive: true, maintainAspectRatio: true, cutout: '65%',
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${fmtINR(ctx.raw)} (${Math.round(ctx.raw / (getTotalBudget()||1) * 100)}%)` } } }
    }
  });
}

// ===================== FLIGHTING CALENDAR =====================
function renderFlighting() {
  const weeks = getWeeks();
  const chs = state.channels;
  if (!chs.length) return;

  // Initialise flighting state
  chs.forEach(ch => {
    if (!state.flighting[ch] || state.flighting[ch].length !== weeks) {
      state.flighting[ch] = Array(weeks).fill(true);
    }
  });

  const table = document.getElementById('flight-table');
  const startDate = document.getElementById('f_start')?.value;
  // Header with seasonality badges
  let html = '<thead><tr><th class="ch-col">Channel</th>';
  for (let w = 0; w < weeks; w++) {
    const evts = detectSeasonality(startDate, w);
    const topEvt = evts.sort((a,b) => b.cpmMultiplier - a.cpmMultiplier)[0];
    const hasSeason = !!topEvt;
    const badge = topEvt ? `<br><span class="season-badge ${topEvt.badge}">${topEvt.emoji} ${topEvt.shortName}</span>` : '';
    html += `<th${hasSeason ? ' class="has-season"' : ''}>W${w+1}${badge}</th>`;
  }
  html += '</tr></thead><tbody>';

  chs.forEach(ch => {
    const cfg = channelConfig[ch];
    const budget = state.budgets[ch] || 0;
    html += `<tr>
      <td class="ch-label">
        <div style="display:flex;align-items:center;gap:4px;">
          <span>${cfg.icon}</span>
          <span>${cfg.name}</span>
          <div class="pattern-btns">
            <button class="pat-btn" onclick="setPattern('${ch}','burst')">Burst</button>
            <button class="pat-btn" onclick="setPattern('${ch}','pulse')">Pulse</button>
            <button class="pat-btn" onclick="setPattern('${ch}','always')">Always-on</button>
          </div>
        </div>
      </td>`;
    for (let w = 0; w < weeks; w++) {
      const active = state.flighting[ch][w];
      const activeCount = state.flighting[ch].filter(Boolean).length || 1;
      const weekBudget = active ? Math.round(budget / activeCount) : 0;
      const intensity = active ? Math.max(30, Math.round((weekBudget / (budget / activeCount)) * 100)) : 0;
      const bg = active ? hexWithAlpha(cfg.color, intensity / 100) : '#f0f2f5';
      const txtColor = active ? 'white' : '#ccc';
      html += `<td><div class="flight-cell" id="fc-${ch}-${w}" style="background:${bg};color:${txtColor};"
        onclick="toggleCell('${ch}',${w})">${active && weekBudget > 0 ? fmtINR(weekBudget) : ''}</div></td>`;
    }
    html += '</tr>';
  });
  html += '</tbody>';
  table.innerHTML = html;
}

function hexWithAlpha(hex, alpha) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

function toggleCell(ch, w) {
  state.flighting[ch][w] = !state.flighting[ch][w];
  renderFlighting();
  recalcProjections();
}

function setPattern(ch, pattern) {
  const weeks = getWeeks();
  const arr = Array(weeks).fill(false);
  if (pattern === 'always') { arr.fill(true); }
  else if (pattern === 'burst') { arr.fill(true, 0, Math.max(2, Math.round(weeks * 0.25))); }
  else if (pattern === 'pulse') { for (let i = 0; i < weeks; i++) arr[i] = i % 2 === 0; }
  state.flighting[ch] = arr;
  renderFlighting();
  recalcProjections();
}

// ===================== SEASONALITY HELPERS =====================
function detectSeasonality(startDate, weekIndex) {
  if (!startDate) return [];
  const d = new Date(startDate);
  d.setDate(d.getDate() + weekIndex * 7);
  const month = d.getMonth();
  return indiaMediaCalendar.filter(ev => ev.months.includes(month));
}

function getSeasonalCPMMultiplier(ch) {
  if (!['digital','tv','ooh'].includes(ch)) return 1;
  const start = document.getElementById('f_start')?.value;
  if (!start) return 1;
  const startDate = new Date(start);
  const month = startDate.getMonth();
  let mult = 1;
  indiaMediaCalendar.forEach(ev => {
    if (ev.months.includes(month)) mult = Math.max(mult, ev.cpmMultiplier);
  });
  return mult;
}

// ===================== PROJECTIONS (SATURATION CURVE MODEL) =====================
function calcProjections(ch) {
  const budget = state.budgets[ch] || 0;
  const bench = getBench(ch);
  const cpmMult = getSeasonalCPMMultiplier(ch);
  if (!budget) return null;

  if (ch === 'digital') {
    const effectiveCPM = (bench.cpm || 100) * cpmMult;
    const impressions = Math.round((budget / effectiveCPM) * 1000);
    // Saturation reach: reach = maxReach * budget / (budget + halfSat)
    const halfSat = saturationParams.digital.halfSat;
    const maxReach = impressions * 0.72; // theoretical max (unique users ≤ 72% of impressions)
    const reach = Math.round(maxReach * budget / (budget + halfSat));
    const clicks = Math.round(impressions * (bench.ctr || 1.2) / 100);
    const conversions = Math.round(clicks * (bench.conv_rate || 2) / 100);
    const seasonNote = cpmMult > 1 ? ` (×${cpmMult.toFixed(1)} seasonal)` : '';
    return { impressions, reach, clicks, conversions, halfSat, cpmMult, effectiveCPM,
      metrics: [
        { label: 'Impressions', value: fmtNum(impressions) },
        { label: 'Est. Reach (saturation model)', value: fmtNum(reach) },
        { label: 'Est. Clicks', value: fmtNum(clicks) },
        { label: 'Est. Conversions', value: fmtNum(conversions) },
        { label: `CPM${seasonNote}`, value: `₹${effectiveCPM.toFixed(0)}` },
      ]};
  }
  if (ch === 'email') {
    const sends = Math.round(budget / 0.5);
    const opens = Math.round(sends * (bench.open || 22) / 100);
    const clicks = Math.round(opens * (bench.ctr || 3.5) / 100);
    return { impressions: opens, reach: sends,
      metrics: [
        { label: 'Est. Sends', value: fmtNum(sends) },
        { label: 'Est. Opens', value: fmtNum(opens) },
        { label: 'Est. Clicks', value: fmtNum(clicks) },
        { label: 'Open Rate', value: `${bench.open}%` },
      ]};
  }
  if (ch === 'tv') {
    const effectiveCPP = (bench.cpp || 20000) * cpmMult;
    const grps = Math.round(budget / effectiveCPP);
    // Saturation: max TV reach ~75%; diminishing beyond halfSat
    const halfSat = saturationParams.tv.halfSat;
    const reachPct = Math.round(75 * budget / (budget + halfSat));
    const recallLift = Math.round(grps / 25);
    const seasonNote = cpmMult > 1 ? ` (×${cpmMult.toFixed(1)} seasonal)` : '';
    return { impressions: grps * 50000, reach: reachPct, halfSat, cpmMult,
      metrics: [
        { label: 'Est. GRPs', value: grps },
        { label: 'Est. Reach (saturation model)', value: `${reachPct}%` },
        { label: 'Avg. Frequency', value: `${bench.freq}x` },
        { label: 'Recall Lift', value: `~${recallLift}pts` },
        { label: `CPP${seasonNote}`, value: fmtINR(effectiveCPP) },
      ]};
  }
  if (ch === 'ooh') {
    const effectiveCPM = (bench.cpm || 60) * cpmMult;
    const impressions = Math.round((budget / effectiveCPM) * 1000);
    const halfSat = saturationParams.ooh.halfSat;
    const maxReach = impressions * 0.6;
    const reach = Math.round(maxReach * budget / (budget + halfSat));
    const locations = Math.round(budget / 50000);
    const seasonNote = cpmMult > 1 ? ` (×${cpmMult.toFixed(1)} seasonal)` : '';
    return { impressions, reach, halfSat, cpmMult,
      metrics: [
        { label: 'Est. Impressions', value: fmtNum(impressions) },
        { label: 'Est. Reach (saturation model)', value: fmtNum(reach) },
        { label: 'Est. Locations', value: locations },
        { label: `CPM${seasonNote}`, value: `₹${effectiveCPM.toFixed(0)}` },
      ]};
  }
  if (ch === 'print') {
    const impressions = Math.round((budget / (bench.cpm || 180)) * 1000 * (bench.readership || 3));
    return { impressions, reach: Math.round(impressions * 0.8),
      metrics: [
        { label: 'Circulation × Readership', value: fmtNum(impressions) },
        { label: 'Readership Multiplier', value: `${bench.readership}x` },
        { label: 'CPM', value: `₹${bench.cpm}` },
      ]};
  }
  if (ch === 'influencer') {
    const halfSat = saturationParams.influencer.halfSat;
    // Saturation on number of quality creators available at scale
    const maxCreators = Math.round(budget / (bench.avg_followers * 0.1));
    const creators = Math.round(maxCreators * budget / (budget + halfSat));
    const reach = Math.round(creators * (bench.avg_followers || 50000));
    const engagements = Math.round(reach * (bench.er || 4) / 100);
    return { impressions: reach, reach, halfSat,
      metrics: [
        { label: 'Est. Creators', value: Math.max(1, creators) },
        { label: 'Est. Reach (saturation model)', value: fmtNum(reach) },
        { label: 'Est. Engagements', value: fmtNum(engagements) },
        { label: 'Avg. ER', value: `${bench.er}%` },
        { label: 'CPE', value: `₹${bench.cpe}` },
      ]};
  }
  return null;
}

let projCache = {};
function recalcProjections() {
  projCache = {};
  state.channels.forEach(ch => { projCache[ch] = calcProjections(ch); });
  // Update sidebar reach
  let totalImpr = 0, totalReach = 0;
  state.channels.forEach(ch => {
    if (projCache[ch]) { totalImpr += projCache[ch].impressions || 0; totalReach += projCache[ch].reach || 0; }
  });
  document.getElementById('sb-reach').textContent = fmtNum(totalReach);
  document.getElementById('sb-impr').textContent = fmtNum(totalImpr);
}

